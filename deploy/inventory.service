[Unit]
Description=Inventaire (application web)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=inventory
Group=inventory
WorkingDirectory=/opt/inventory
EnvironmentFile=/etc/inventory/inventory.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/inventory/dist/server.js
Restart=on-failure
RestartSec=3
UMask=0027
# Mémoire plafonnée : un import ou une image anormale ne peut pas faire tomber le conteneur (ni MariaDB).
Environment=NODE_OPTIONS=--max-old-space-size=320
MemoryHigh=384M
MemoryMax=512M
OOMPolicy=stop

# Durcissement
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/inventory
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
