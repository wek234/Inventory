<% layout('/layout') %>
<%~ include('/_subnav', { space: 'administration', path: it.path, h: it.h }) %>
<div class="page-head"><h1>Comptes</h1></div>
<div class="cols">
  <section class="card">
    <div class="card-head"><h2>Comptes existants</h2><span class="muted small">cliquez sur un compte pour le modifier</span></div>
    <div class="table-wrap">
    <table class="table responsive clickable">
      <thead><tr><th>Identifiant</th><th>Rôle</th><th>Sécurité</th><th>Dernière connexion</th><th></th></tr></thead>
      <tbody>
      <% for (const u of it.users) { const self = it.user && u.id === it.user.id; %>
        <tr data-href="/administration/comptes/<%= u.id %>">
          <td><span class="account-id"><span class="avatar avatar-sm" aria-hidden="true"><%= u.username.slice(0, 1).toUpperCase() %></span><a class="title" href="/administration/comptes/<%= u.id %>"><%= u.username %></a><% if (self) { %> <span class="badge badge-bleu">vous</span><% } %><% if (u.locked) { %> <span class="badge badge-rouge">verrouillé</span><% } %></span></td>
          <td data-label="Rôle"><span class="badge <%= u.role === 'admin' ? 'badge-violet' : 'badge-gris' %>"><%= u.role === 'admin' ? 'Administrateur' : 'Lecture seule' %></span></td>
          <td data-label="Sécurité" class="small"><%= u.totp_enabled ? 'TOTP configuré' : 'TOTP à configurer' %> · <%= it.h.plural(u.passkeys, 'clé d’accès', 'clés d’accès') %></td>
          <td data-label="Dernière connexion" class="small nowrap"><%= u.lastLogin ? it.h.dateTime(u.lastLogin) : 'jamais' %></td>
          <td class="nowrap"><a class="btn btn-sm" href="/administration/comptes/<%= u.id %>"><%~ it.h.icon('edit') %>Modifier</a></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    </div>
  </section>
  <section class="card">
    <div class="card-head"><h2>Nouveau compte</h2></div>
    <div class="card-body">
      <form method="post" action="/administration/comptes" class="stack" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <div class="field"><label for="a-user">Identifiant</label><input id="a-user" name="username" type="text" maxlength="64" pattern="[A-Za-z0-9._\-]{3,64}" required><span class="hint">3 à 64 caractères : lettres, chiffres, . _ -</span></div>
        <div class="field"><label for="a-role">Rôle</label>
          <select id="a-role" name="role"><option value="lecture">Lecture seule (consultation)</option><option value="admin">Administrateur (tous les droits)</option></select></div>
        <div class="field"><label for="a-pw">Mot de passe initial</label><input id="a-pw" name="password" type="password" minlength="<%= it.minLength %>" autocomplete="new-password" required><span class="hint"><%= it.minLength %> caractères minimum. À transmettre à la personne : la double authentification lui sera demandée à la première connexion.</span></div>
        <div><button class="btn btn-primary" type="submit">Créer le compte</button></div>
      </form>
    </div>
  </section>
</div>
