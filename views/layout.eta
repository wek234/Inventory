<!doctype html>
<html lang="fr" data-theme="<%= it.theme %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title || 'Inventaire' %> · Inventaire</title>
<meta name="csrf-token" content="<%= it.csrf %>">
<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"historyCacheSize":0}'>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="<%= it.h.asset('icon.svg') %>" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="<%= it.h.asset('icons/apple-touch-icon.png') %>">
<meta name="theme-color" content="#2d5bd2">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="stylesheet" href="<%= it.h.asset('app.css') %>">
<script src="<%= it.h.asset('vendor/htmx.min.js') %>" defer></script>
<script src="<%= it.h.asset('app.js') %>" defer></script>
<% for (const st of (it.styles || [])) { %><link rel="stylesheet" href="<%= st %>">
<% } %><% for (const sc of (it.scripts || [])) { %><script src="<%= it.h.asset(sc) %>" defer></script>
<% } %></head>
<body data-app>
<%
  const under = (href) => it.path === href || it.path.startsWith(href + '/');
  const nav = [
    ['/', 'Tableau de bord', 'dashboard', it.path === '/'],
    ['/objets', 'Objets', 'items', under('/objets')],
  ];
  const tools = it.canEdit ? [
    ['/corbeille', 'Corbeille', 'trash'], ['/rangement', 'Rangement', 'scan'], ['/historique', 'Historique', 'history'], ['/import', 'Import', 'import'], ['/export', 'Export', 'export'],
  ] : [];
  const settingsActive = ['/parametres', '/categories', '/emplacements', '/statuts'].some(under);
  const adminActive = ['/administration', '/personnes'].some(under);
  const uname = it.user ? it.user.username : '';
  const toolsOpen = tools.some((t) => under(t[0]));
  const active = under;
  const themeLabel = { auto: 'Thème : automatique', light: 'Thème : clair', dark: 'Thème : sombre' }[it.theme];
%>
<header class="topbar">
  <a class="brand" href="/"><%~ it.h.icon('items') %>Inventaire</a>
  <button class="btn btn-sm" type="button" data-action="menu" aria-label="Menu"><%~ it.h.icon('menu') %>Menu</button>
</header>
<div class="app">
  <nav class="sidebar" aria-label="Navigation principale">
    <a class="brand" href="/"><%~ it.h.icon('items') %>Inventaire</a>
    <div class="nav">
    <% for (const n of nav) { %>
      <% if (!n) { %><div class="nav-sep"></div><% } else { %>
      <a href="<%= n[0] %>" class="<%= n[3] ? 'active' : '' %>"<%~ n[3] ? ' aria-current="page"' : '' %>><%~ it.h.icon(n[2]) %><span><%= n[1] %></span></a>
      <% } %>
    <% } %>
    <% if (tools.length) { %>
      <details class="nav-group" data-nav-group="outils"<%~ toolsOpen ? ' open data-forced' : '' %>>
        <summary><%~ it.h.icon('tools') %><span>Outils</span><span class="nav-caret" aria-hidden="true"></span></summary>
        <% for (const t of tools) { %>
        <a href="<%= t[0] %>" class="<%= under(t[0]) ? 'active' : '' %>"<%~ under(t[0]) ? ' aria-current="page"' : '' %>><%~ it.h.icon(t[2]) %><span><%= t[1] %></span></a>
        <% } %>
      </details>
    <% } %>
    <% if (it.canEdit) { %>
      <a href="/parametres" class="<%= settingsActive ? 'active' : '' %>"<%~ settingsActive ? ' aria-current="page"' : '' %>><%~ it.h.icon('settings') %><span>Paramètres</span></a>
    <% } %>
    </div>
    <div class="sidebar-foot">
      <button class="nav-btn" type="button" data-action="quick-search" title="Recherche rapide (Ctrl+K)"><%~ it.h.icon('search') %><span>Rechercher <kbd>Ctrl K</kbd></span></button>
      <details class="user-menu" data-user-menu>
        <summary class="user-btn<%= active('/compte') || adminActive ? ' active' : '' %>">
          <span class="avatar" aria-hidden="true"><%= uname.slice(0, 1).toUpperCase() %></span>
          <span class="user-name"><%= uname %><% if (it.user && it.user.role === 'lecture') { %><span class="muted small">lecture seule</span><% } %></span>
          <span class="nav-caret" aria-hidden="true"></span>
        </summary>
        <div class="user-pop" role="menu">
          <a href="/compte" role="menuitem" class="<%= active('/compte') ? 'active' : '' %>"><%~ it.h.icon('account') %><span>Mon compte</span></a>
          <% if (it.canEdit) { %><a href="/administration" role="menuitem" class="<%= adminActive ? 'active' : '' %>"><%~ it.h.icon('shield') %><span>Administration</span></a><% } %>
          <button type="button" role="menuitem" data-action="theme"><%~ it.h.icon('theme') %><span data-theme-label><%= themeLabel %></span></button>
          <form method="post" action="/logout" class="inline">
            <input type="hidden" name="_csrf" value="<%= it.csrf %>">
            <button type="submit" role="menuitem"><%~ it.h.icon('logout') %><span>Se déconnecter</span></button>
          </form>
        </div>
      </details>
    </div>
  </nav>
  <main class="main" id="main">
    <% if (it.flash) { %><div class="flash <%= it.flash.type %>" role="status"><%= it.flash.msg %></div><% } %>
    <%~ it.body %>
  </main>
</div>
</body>
</html>
