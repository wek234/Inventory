<% layout('/layout') %>
<%~ include('/_subnav', { space: 'parametres', path: it.path, h: it.h }) %>
<% const k = it.kind; const n = it.node; const isCat = k.table === 'categories'; %>
<div class="page-head">
  <div>
    <% const parent = it.lineage.length > 1 ? it.lineage[it.lineage.length - 2] : null; %>
    <a class="btn btn-back" href="<%= parent ? k.base + '/' + parent.id : k.base %>">Retour <%= parent ? 'à « ' + parent.name + ' »' : 'aux ' + k.many.toLowerCase() %></a>
    <div class="crumbs"><a href="<%= k.base %>"><%= k.many %></a><% for (const a of it.lineage.slice(0, -1)) { %> › <a href="<%= k.base %>/<%= a.id %>"><%= a.name %></a><% } %></div>
    <h1><%= n.name %></h1>
    <% if (n.description) { %><p class="muted pre"><%= n.description %></p><% } %>
  </div>
  <div class="actions">
    <% if (!isCat && it.canEdit) { %><a class="btn" href="/emplacements/<%= n.id %>/etiquette">Étiquette QR</a><% } %>
    <a class="btn" href="/objets?<%= k.itemFilter %>=<%= n.id %>">Voir les objets (<%= it.total.get(n.id) || 0 %>)</a>
    <% if (it.canEdit) { %><a class="btn<%= isCat ? '' : ' btn-primary' %>" href="/objets/nouveau?<%= k.itemFilter %>=<%= n.id %>">Nouvel objet ici</a><% } %>
    <% if (isCat && it.canEdit) { %><button class="btn btn-primary" type="submit" form="cat-form">Enregistrer la catégorie</button><% } %>
  </div>
</div>

<% if (isCat) { %>
<form id="cat-form" method="post" action="/categories/<%= n.id %>" class="cols" data-dirty-check>
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <div class="stack">
    <section class="card" id="caracteristiques">
      <div class="card-head"><h2>Caractéristiques</h2><span class="muted small">proposées sur chaque objet de cette catégorie et de ses sous-catégories</span></div>
      <% if (it.errors && it.errors.length) { %>
      <div class="card-body"><ul class="error-list"><% for (const e of it.errors) { %><li><%= e %></li><% } %></ul></div>
      <% } %>
      <% for (const g of it.inheritedGroups) { %>
      <div class="card-body inherited">
        <div class="label">Héritées de <a href="/categories/<%= g.id %>"><%= g.path %></a></div>
        <ul class="inherited-list">
          <% for (const d of g.defs) { %><li><span><%= d.name %></span><span class="muted small"><%= it.h.attrTypeLabel(d.type) %><%= d.unit ? ', ' + d.unit : '' %><%= d.optional ? ', facultative' : '' %></span></li><% } %>
        </ul>
      </div>
      <% } %>
      <div class="card-body">
        <% if (it.inheritedGroups.length) { %><div class="label">Propres à « <%= n.name %> »</div><% } %>
        <% if (!it.ownDefs.length && !(it.newDefs && it.newDefs.length)) { %><p class="muted" data-empty-defs>Aucune caractéristique propre à cette catégorie.</p><% } %>
        <% it.ownDefs.forEach((d, idx) => { %><%~ include('/trees/_defrow', { d, key: 'd' + d.id, used: d.used, isNew: false, error: d.error, first: idx === 0, h: it.h }) %><% }) %>
        <div id="new-defs">
          <% (it.newDefs || []).forEach((d) => { %><%~ include('/trees/_defrow', { d: { name: d.name, type: d.type, unit: d.unit, optionList: d.optionsRaw ? d.optionsRaw.split(/\r?\n/) : [], sort_order: d.sort, optional: d.optional }, key: d.key, used: 0, isNew: true, error: d.error, first: false, h: it.h }) %><% }) %>
        </div>
        <template id="def-template"><%~ include('/trees/_defrow', { d: { name: '', type: 'text', unit: '', optionList: [], sort_order: '', optional: 0 }, key: 'n__N__', used: 0, isNew: true, first: false, h: it.h }) %></template>
        <div class="row def-add"><button class="btn btn-sm" type="button" data-action="add-def"><%~ it.h.icon('plus') %>Ajouter une caractéristique</button><span class="hint">enregistrée avec le bouton « Enregistrer la catégorie »</span></div>
      </div>
    </section>
  </div>
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Catégorie</h2></div>
      <div class="card-body stack">
        <div class="field"><label for="e-name">Nom</label><input id="e-name" name="name" type="text" value="<%= it.formName !== undefined ? it.formName : n.name %>" maxlength="120" required></div>
        <div class="field">
          <label for="e-parent">Dans</label>
          <select id="e-parent" name="parent_id">
            <option value="">(racine)</option>
            <% for (const p of it.parents) { %><option value="<%= p.id %>" <%= n.parent_id === p.id ? 'selected' : '' %>><%= it.h.indent(p.depth) %><%= p.name %></option><% } %>
          </select>
        </div>
        <div class="field"><label for="e-desc">Description</label><textarea id="e-desc" name="description" rows="3"><%= n.description || '' %></textarea></div>
      </div>
    </section>
  </div>
</form>
<% for (const d of it.ownDefs) { %>
<form id="del-<%= d.id %>" method="post" action="/caracteristiques/<%= d.id %>/supprimer" class="hidden" data-def-delete data-confirm="Supprimer la caractéristique « <%= d.name %> » ? Les valeurs déjà saisies resteront sur les objets en caractéristiques libres."><input type="hidden" name="_csrf" value="<%= it.csrf %>"></form>
<% } %>
<% } %>

<div class="cols">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Sous-<%= k.one %>s</h2></div>
      <% if (it.children.length) { %>
      <ul class="tree">
        <% for (const c of it.children) { %>
        <li class="d0"><a href="<%= k.base %>/<%= c.id %>"><%= c.name %></a><a class="count" href="/objets?<%= k.itemFilter %>=<%= c.id %>"><%= it.direct.get(c.id) || 0 %> / <%= it.total.get(c.id) || 0 %></a></li>
        <% } %>
      </ul>
      <% } %>
      <% if (it.canEdit) { %>
      <div class="card-body">
        <form method="post" action="<%= k.base %>" class="row">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <input type="hidden" name="parent_id" value="<%= n.id %>">
          <label class="sr-only" for="c-name">Nom</label>
          <input id="c-name" name="name" type="text" maxlength="120" required placeholder="Nom du sous-élément">
          <button class="btn btn-sm" type="submit">Ajouter</button>
        </form>
      </div>
      <% } %>
    </section>
  </div>

  <% if (it.canEdit) { %>
  <div class="stack">
    <% if (!isCat) { %>
    <section class="card">
      <div class="card-head"><h2>Modifier</h2></div>
      <div class="card-body">
        <form method="post" action="<%= k.base %>/<%= n.id %>" class="stack">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <div class="field"><label for="e-name">Nom</label><input id="e-name" name="name" type="text" value="<%= n.name %>" maxlength="120" required></div>
          <div class="field">
            <label for="e-parent">Dans</label>
            <select id="e-parent" name="parent_id">
              <option value="">(racine)</option>
              <% for (const p of it.parents) { %><option value="<%= p.id %>" <%= n.parent_id === p.id ? 'selected' : '' %>><%= it.h.indent(p.depth) %><%= p.name %></option><% } %>
            </select>
          </div>
          <div class="field"><label for="e-desc">Description</label><textarea id="e-desc" name="description" rows="3"><%= n.description || '' %></textarea></div>
          <div><button class="btn btn-primary" type="submit">Enregistrer</button></div>
        </form>
      </div>
    </section>
    <% } %>
    <section class="card">
      <div class="card-head"><h2>Supprimer</h2></div>
      <div class="card-body">
        <p class="small muted">Possible uniquement si aucun objet ni sous-élément n’y est rattaché.</p>
        <form method="post" action="<%= k.base %>/<%= n.id %>/supprimer" data-confirm="Supprimer « <%= n.name %> » ?">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <button class="btn btn-danger" type="submit">Supprimer</button>
        </form>
      </div>
    </section>
  </div>
  <% } %>
</div>
