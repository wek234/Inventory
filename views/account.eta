<% layout('/layout', { ...it, scripts: ['vendor/simplewebauthn.min.js'] }) %>
<div class="page-head"><h1>Mon compte</h1></div>
<div class="grid-2">
  <section class="card">
    <div class="card-head"><h2>Mot de passe</h2></div>
    <div class="card-body">
      <form method="post" action="/compte/mot-de-passe" class="stack" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <input type="text" name="username" value="<%= it.account.username %>" autocomplete="username" class="hidden" aria-hidden="true" tabindex="-1">
        <div class="field"><label for="p-cur">Mot de passe actuel</label><input id="p-cur" name="current" type="password" autocomplete="current-password" required></div>
        <div class="field"><label for="p-new">Nouveau mot de passe</label><input id="p-new" name="new" type="password" autocomplete="new-password" minlength="<%= it.minLength %>" required><span class="hint"><%= it.minLength %> caractères minimum.</span></div>
        <div class="field"><label for="p-conf">Confirmation</label><input id="p-conf" name="confirm" type="password" autocomplete="new-password" required></div>
        <div class="field"><label for="p-code">Code TOTP</label><input id="p-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required></div>
        <div><button class="btn btn-primary" type="submit">Changer le mot de passe</button></div>
        <p class="small muted">Vos autres sessions seront fermées.</p>
      </form>
    </div>
  </section>
  <div class="stack">
    <section class="card" id="securite">
      <div class="card-head"><h2>Double authentification et clés d’accès</h2></div>
      <div class="card-body">
        <div class="label">Application TOTP</div>
        <p class="small muted">Pour changer de téléphone ou d’application : confirmez avec votre mot de passe et un code actuel, puis scannez le nouveau QR code.</p>
        <form method="post" action="/compte/totp" class="stack">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <div class="grid-2">
            <div class="field"><label for="t-cur">Mot de passe</label><input id="t-cur" name="current" type="password" autocomplete="current-password" required></div>
            <div class="field"><label for="t-code">Code actuel</label><input id="t-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required></div>
          </div>
          <div><button class="btn" type="submit">Reconfigurer le TOTP</button></div>
        </form>
      </div>
      <div id="passkeys" class="section-split">
      <div class="card-body pb-0"><div class="label">Clés d’accès (passkeys)</div></div>
    <% if (it.passkeys.length) { %>
      <ul class="list">
        <% for (const k of it.passkeys) { %>
        <li><div><strong><%= k.name %></strong><div class="meta">Ajoutée le <%= it.h.dateTime(k.created_at) %><%= k.last_used_at ? ' · dernière utilisation ' + it.h.dateTime(k.last_used_at) : '' %></div></div>
          <form method="post" action="/compte/passkeys/<%= k.id %>/supprimer" class="inline" data-confirm="Supprimer la clé « <%= k.name %> » ?"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn btn-sm btn-danger" type="submit">Supprimer</button></form></li>
        <% } %>
      </ul>
      <% } %>
    <div class="card-body stack">
        <p class="small muted">Connexion sans mot de passe ni code, avec l’empreinte, le visage ou le code PIN de votre appareil (téléphone, ordinateur, clé de sécurité). Plus sûre que le mot de passe : elle ne peut pas être hameçonnée.</p>
        <div class="row">
          <label class="sr-only" for="pk-name">Nom de la clé</label>
          <input id="pk-name" type="text" maxlength="100" placeholder="Nom (ex. Téléphone, PC bureau)" data-passkey-name>
          <button class="btn btn-primary" type="button" data-action="passkey-register"><%~ it.h.icon('key') %>Ajouter une clé d’accès</button>
        </div>
        <p class="err" data-passkey-error hidden></p>
      </div>
      </div>
    </section>
    <% if (it.oidc.enabled) { %>
    <section class="card">
      <div class="card-head"><h2>SSO (<%= it.oidc.label %>)</h2></div>
      <div class="card-body">
        <% if (it.account.oidc_sub) { %>
          <p class="small">Compte associé.</p>
          <form method="post" action="/compte/oidc/dissocier" data-confirm="Dissocier le compte SSO ?"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn btn-danger btn-sm" type="submit">Dissocier</button></form>
        <% } else { %>
          <p class="small muted">Aucun compte SSO associé.</p>
          <a class="btn btn-sm" href="/compte/oidc/associer">Associer mon compte <%= it.oidc.label %></a>
        <% } %>
      </div>
    </section>
    <% } %>
  </div>
</div>

<div class="mt">
  <section class="card" id="jetons">
    <div class="card-head"><h2>Jetons d’API</h2><a class="small" href="/api/v1" title="Documentation de l’API">Documentation</a></div>
    <% if (it.tokens.length) { %>
    <ul class="list">
      <% for (const t of it.tokens) { %>
      <li><div><strong><%= t.name %></strong> <span class="badge <%= t.scope === 'ecriture' ? 'badge-orange' : 'badge-gris' %>"><%= t.scope === 'ecriture' ? 'lecture + écriture' : 'lecture' %></span>
        <div class="meta mono"><%= t.prefix %>…</div>
        <div class="meta">Créé le <%= it.h.dateTime(t.created_at) %><%= t.last_used_at ? ' · utilisé le ' + it.h.dateTime(t.last_used_at) : ' · jamais utilisé' %><%= t.expires_at ? ' · expire le ' + it.h.dateTime(t.expires_at) : '' %></div></div>
        <form method="post" action="/compte/jetons/<%= t.id %>/supprimer" class="inline" data-confirm="Révoquer le jeton « <%= t.name %> » ?"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn btn-sm btn-danger" type="submit">Révoquer</button></form></li>
      <% } %>
    </ul>
    <% } %>
    <div class="card-body">
      <form method="post" action="/compte/jetons" class="stack">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <div class="grid-2">
          <div class="field"><label for="tk-name">Nom</label><input id="tk-name" name="name" type="text" maxlength="100" required placeholder="ex. Home Assistant"></div>
          <div class="field"><label for="tk-days">Expiration</label>
            <select id="tk-days" name="days"><option value="30">30 jours</option><option value="90">90 jours</option><option value="365" selected>1 an</option><option value="0">Jamais</option></select></div>
        </div>
        <% if (it.canEdit) { %>
        <div class="field"><label for="tk-scope">Droits</label>
          <select id="tk-scope" name="scope"><option value="lecture">Lecture seule</option><option value="ecriture">Lecture et écriture</option></select></div>
        <% } %>
        <div><button class="btn" type="submit">Créer un jeton</button></div>
        <p class="small muted">Le jeton n’est affiché qu’une fois, à la création. Seule son empreinte est conservée.</p>
      </form>
    </div>
  </section>
</div>
<section class="card mt">
  <div class="card-head"><h2>Sessions actives</h2></div>
  <div class="table-wrap">
  <table class="table responsive">
    <thead><tr><th>Appareil</th><th>Adresse IP</th><th>Ouverte le</th><th>Dernière activité</th><th></th></tr></thead>
    <tbody>
    <% for (const s of it.sessions) { %>
      <tr>
        <td class="small"><%= (s.user_agent || 'Inconnu').slice(0, 90) %><% if (s.id === it.currentSession) { %> <span class="badge badge-bleu">cette session</span><% } %></td>
        <td data-label="IP" class="mono small"><%= s.ip || '' %></td>
        <td data-label="Ouverte le" class="small nowrap"><%= it.h.dateTime(s.created_at) %></td>
        <td data-label="Activité" class="small nowrap"><%= it.h.dateTime(s.last_seen_at) %></td>
        <td class="actions"><form method="post" action="/compte/sessions/<%= s.id %>/fermer" class="inline"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn btn-sm" type="submit">Fermer</button></form></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
</section>
