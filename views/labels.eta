<% layout('/layout') %>
<div class="page-head no-print">
  <div>
    <a class="btn btn-back" href="<%= it.back %>">Retour</a>
    <h1>Étiquettes QR</h1>
    <p class="muted small"><%= it.h.plural(it.labels.length, 'étiquette', 'étiquettes') %> · <%= it.format.label %>. Le QR code ouvre la fiche (connexion requise).<% if (it.truncated) { %> Limité aux 500 premiers objets : affinez les filtres.<% } %></p>
    <form method="get" class="row mt label-format">
      <% for (const [k, v] of it.keepParams) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } %>
      <label for="lf" class="sr-only">Format</label>
      <select id="lf" name="f" class="w-auto" data-autosubmit-get>
        <% for (const f of it.formats) { %><option value="<%= f.key %>" <%= it.format.key === f.key ? 'selected' : '' %>><%= f.label %></option><% } %>
        <option value="perso" <%= it.format.key === 'perso' ? 'selected' : '' %>>Personnalisé…</option>
      </select>
      <span class="row" data-custom-size <%= it.format.key === 'perso' ? '' : 'hidden' %>>
        <label for="lw" class="sr-only">Largeur (mm)</label><input id="lw" name="w" type="number" min="20" max="200" step="0.5" value="<%= it.format.w %>" class="w-num"> ×
        <label for="lh" class="sr-only">Hauteur (mm)</label><input id="lh" name="h" type="number" min="12" max="200" step="0.5" value="<%= it.format.h %>" class="w-num"> mm
      </span>
      <button class="btn btn-sm" type="submit">Appliquer</button>
    </form>
    <p class="small muted">À l’impression : choisissez l’imprimante d’étiquettes et le même format de papier, échelle 100 %, sans marges.</p>
  </div>
  <div class="actions"><button class="btn btn-primary" type="button" data-action="print" data-printed-ids="<%= (it.itemIds || []).join(',') %>">Imprimer</button></div>
</div>
<div class="labels">
  <% for (const l of it.labels) { %>
  <div class="label-card">
    <%~ l.svg %>
    <div>
      <div class="t"><%= l.title %></div>
      <% if (l.sub) { %><div class="s"><%= l.sub %></div><% } %>
      <div class="c"><%= l.code %></div>
    </div>
  </div>
  <% } %>
</div>
